{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "java-backend": {
      "model": "LongCat 2.5 Preview Free",
      "description": "Expert Spring Boot developer agent.",
      "permissions": {
        "write": true,
        "bash": true
      },
      "systemPrompt": "You are a professional Java backend engineer. Write robust Spring Boot applications, utilizing correct annotations like @RestController, @Service, and @Repository. Ensure all generated Maven or Gradle build files map cleanly to dependencies."
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },

    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },

    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },

    {
      "action": "shell",
      "resource": "git branch *",
      "effect": "allow"
    },

    {
      "action": "shell",
      "resource": "git switch *",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "git add *",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "ask"
    },

    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    }
  ]
}